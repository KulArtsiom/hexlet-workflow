# Базовый образ: официальный Node.js 26 в варианте slim.
# slim — урезанная Debian без компиляторов и лишних утилит:
# ~200 МБ вместо ~1 ГБ, быстрее тянется, меньше дыр для атак.
# Разработчики просили Node >= 20, берём актуальную LTS-ветку.
FROM node:26-slim

# Рабочая директория внутри контейнера.
# Все следующие команды (COPY, RUN, CMD) выполняются относительно неё.
# Если папки нет — Docker создаст сам.
WORKDIR /app

# Копируем ТОЛЬКО манифесты зависимостей, без кода:
# - package.json / package-lock.json — список и точные версии зависимостей
# - .npmrc — настройки npm (в нём node-options для Jest, без него тесты в образе упадут)
# Зачем отдельно от кода — см. комментарий к npm ci ниже.
COPY package*.json .npmrc ./

# Устанавливаем зависимости строго по package-lock.json.
# npm ci (а не npm install): ничего не «дорешивает», версии точь-в-точь
# как в локе — сборка воспроизводима, в CI и локально одинаково.
#
# ГЛАВНЫЙ ТРЮК — кеширование слоёв. Docker кеширует результат каждой
# инструкции. Этот слой пересобирается ТОЛЬКО если изменились файлы
# из COPY выше (манифесты). Правишь код — кеш жив, npm ci не запускается,
# пересборка занимает секунды. Поменяй местами с "COPY . ." — и любая
# правка кода будет заново тянуть все зависимости, минуты вместо секунд.
RUN npm ci

# Теперь копируем весь проект (код, вьюхи, статику, тесты).
# Что именно попадёт — фильтрует .dockerignore:
# node_modules, .env, .git и прочее в образ не проходят.
COPY . .

# Команда по умолчанию при старте контейнера.
# Через npm start (а не bin/start.sh напрямую), потому что npm
# автоматически добавляет node_modules/.bin в PATH — там лежит
# fastify-cli, который зовёт наш стартовый скрипт.
# Форма ["npm", "start"] (exec-форма) — процесс получает сигналы
# ОС напрямую (SIGTERM при docker stop), контейнер останавливается
# корректно, а не убивается по таймауту.
CMD ["npm", "start"]