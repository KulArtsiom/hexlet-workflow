# Домен, который обслуживает Caddy.
# Пока только localhost — для разработки.
# Продакшен-домен добавится в уроке про деплой.
localhost, devops-example.test {
	# Самоподписной сертификат: HTTPS работает локально
	# без покупки домена. Браузер предупредит о недоверии — норма.
	# В продакшене эту строку убирают, и Caddy сам получает
	# настоящий сертификат Let's Encrypt.
	tls internal

	# Статика в обход приложения.
	# Запрос /images/logo.svg -> файл /app/public/images/logo.svg
	# (та копия проекта из Dockerfile выше).
	# file_server — модуль раздачи файлов, root — где искать.
	handle /images/* {
		file_server
		root * /app/public
	}

	# Балансировка: перечисляем все бэкенды через пробел.
	# app:3000 — локальный контейнер через docker-сеть,
	# второй адрес — app на web2 через внутреннюю сеть VPC.
	handle {
		reverse_proxy app:3000 10.129.0.24:3000 {
			# По очереди, а не случайно — чтобы чередование
			# сообщений было видно глазами при обновлении.
			lb_policy round_robin

			# Активные health-проверки: Caddy сам опрашивает
			# /health каждые 5 секунд и выкидывает мёртвый
			# бэкенд из ротации — вот зачем разработчики
			# делали этот эндпоинт.
			health_uri /health
			health_interval 5s
		}
	}

	# Логи в json — по ним видно, какие запросы обработал
	# сам Caddy (в т.ч. статику, которая до app не дошла).
	log {
		format json
	}
}