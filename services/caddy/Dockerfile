# Официальный образ Caddy. Но «голый» нам не подходит:
# в продакшене конфигурация должна быть ЧАСТЬЮ образа —
# один артефакт = веб-сервер + его настройки.
# Поэтому собираем свой образ поверх официального.
FROM caddy

# Зашиваем конфиг в образ.
# Caddy при старте читает /etc/caddy/Caddyfile — стандартный путь.
# Путь в COPY — от корня проекта, потому что context сборки
# будет корень (задаём это в compose на шаге 3).
COPY services/caddy/Caddyfile /etc/caddy/

# Копируем проект внутрь образа Caddy.
# Зачем прокси наш код? Ради статики: Caddy будет отдавать
# /images/* сам, напрямую с диска, не гоняя запрос в Node.
# Быстрее, и приложение не тратит ресурсы на картинки.
COPY . /app